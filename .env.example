# determinista y no envía descripciones a ningún proveedor externo.
# Al activarlo, la descripción del reporte se envía al proveedor configurado;
# nunca incluyas datos identificables del paciente.
AI_LLM_API_KEY=""
AI_LLM_BASE_URL="https://api.openai.com/v1"
AI_LLM_MODEL="gpt-4o-mini"

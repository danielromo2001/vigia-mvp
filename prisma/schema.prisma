generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  label String
  users User[]
}

model User {
  id              Int             @id @default(autoincrement())
  name            String
  email           String          @unique
  passwordHash    String
  roleId          Int
  role            Role            @relation(fields: [roleId], references: [id])
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  workOrders      WorkOrder[]     @relation("Responsable")
  reports         FailureReport[] @relation("Reportante")
  reviewedReports FailureReport[] @relation("Revisor")
  partMovements   PartMovement[]
}

model Equipment {
  id            Int              @id @default(autoincrement())
  code          String           @unique
  name          String
  brand         String?
  model         String?
  serial        String           @unique
  location      String
  acquisitionDate DateTime?
  status        String           @default("operativo")
  criticality   String           @default("media")
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  history       MaintenanceLog[]
  workOrders    WorkOrder[]
  reports       FailureReport[]
  plan          PreventivePlan?
}

model MaintenanceLog {
  id          Int        @id @default(autoincrement())
  equipmentId Int
  equipment   Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  date        DateTime   @default(now())
  eventType   String
  description String
  workOrderId Int?       @unique
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([equipmentId, date])
}

model WorkOrder {
  id            Int             @id @default(autoincrement())
  code          String          @unique
  equipmentId   Int
  equipment     Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  type          String
  category      String?
  priority      String          @default("media")
  status        String          @default("abierta")
  responsibleId Int?
  responsible   User?           @relation("Responsable", fields: [responsibleId], references: [id], onDelete: SetNull)
  description   String
  observations  String?
  openedAt      DateTime        @default(now())
  dueDate       DateTime?
  closedAt      DateTime?
  aiAssisted    Boolean         @default(false)
  aiConfidence  Float?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  log           MaintenanceLog?
  originReport  FailureReport?  @relation("OrdenGenerada")
  partMovements PartMovement[]

  @@index([status, openedAt])
}

model PreventivePlan {
  id            Int        @id @default(autoincrement())
  equipmentId   Int        @unique
  equipment     Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  frequencyDays Int
  lastDate      DateTime?
  nextDate      DateTime
  active        Boolean    @default(true)
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([nextDate])
}

/// Reporte de falla con triaje asistido por IA. Guarda la sugerencia original
/// y la decisión del técnico para conservar la trazabilidad de la supervisión
/// humana. Los campos `ai*` se serializan como JSON en SQLite.
model FailureReport {
  id                 Int        @id @default(autoincrement())
  code               String     @unique
  equipmentId        Int
  equipment          Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  reporterId         Int?
  reporter           User?      @relation("Reportante", fields: [reporterId], references: [id], onDelete: SetNull)
  description        String
  impact             String     @default("medio")
  status             String     @default("pendiente")
  aiCategory         String
  aiPriority         String
  aiConfidence       Float
  aiScores           String
  aiKeywords         String
  aiReasons          String
  aiSuggestedType    String
  aiSuggestedDueDate DateTime
  aiModel            String
  aiSource           String     @default("heuristic")
  finalCategory      String?
  finalPriority      String?
  decision           String?
  reviewNotes        String?
  reviewedById       Int?
  reviewedBy         User?      @relation("Revisor", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  workOrderId        Int?       @unique
  workOrder          WorkOrder? @relation("OrdenGenerada", fields: [workOrderId], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([equipmentId, createdAt])
}

/// Repuesto o consumible del almacén biomédico. El stock se actualiza con
/// movimientos trazables (entrada, salida, ajuste o solicitud de compra).
model SparePart {
  id         Int            @id @default(autoincrement())
  code       String         @unique
  name       String
  category   String         @default("otro")
  location   String
  stock      Int            @default(0)
  minStock   Int            @default(0)
  unit       String         @default("unidad")
  unitCost   Float          @default(0)
  supplierId Int?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  active     Boolean        @default(true)
  notes      String?
  movements  PartMovement[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([category])
}

model PartMovement {
  id          Int        @id @default(autoincrement())
  partId      Int
  part        SparePart  @relation(fields: [partId], references: [id], onDelete: Cascade)
  type        String
  quantity    Int
  reason      String?
  workOrderId Int?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  userId      Int?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([partId, createdAt])
}

/// Proveedor de equipos, repuestos o servicios técnicos. El desempeño es una
/// calificación explicable (0-100) construida con los criterios del comité.
model Supplier {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  specialty   String
  contactName String?
  phone       String?
  email       String?
  performance Int                @default(0)
  status      String             @default("aprobado")
  notes       String?
  contracts   SupplierContract[]
  parts       SparePart[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status])
}

model SupplierContract {
  id          Int      @id @default(autoincrement())
  supplierId  Int
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  code        String   @unique
  description String
  startDate   DateTime
  endDate     DateTime
  value       Float    @default(0)
  slaHours    Int      @default(0)
  nextReview  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([endDate])
}
